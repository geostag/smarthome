# influx setup
INFLUX_ORG=smarthome
INFLUX_BUCKET=smarthome
INFLUX_RETENTION=366d
INFLUX_DERIVED_BUCKET=smarthomederived
INFLUX_DERIVED_RETENTION=1830d
INFLUX_LONGRANGE_BUCKET=longrange
INFLUX_LONGRANGE_RETENTION=0

# how to connect to influxdb internally
