REMOTEWEATHER_INTERVAL=300

# sun forecast
SUNFORECASTURL="https://api.open-meteo.com/v1/forecast?latitude=48.137&longitude=11.575&hourly=sunshine_duration&timezone=Europe%2FBerlin&forecast_days=1"

