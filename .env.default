# the scripts to start as permanent daemons
SENSORS="smart-manager.py fritz2influxdb.py mqtt2influxdb.py mystrom2influxdb.py nextcloud-usage2influxdb.py remotetemperature2influxdb.py schatzkiste-latest2influxdb.py smartthings2influxdb.py zendure2influxdb.py nextcloud-usage2influxdb.py schatzkiste-latest2influxdb.py"
#SENSORS="remotetemperature2influxdb.py"

# Interval to query REST APIs (seconds).
QUERY_INTERVAL=60

# --- Smart Manager ---
INJECTION_MAX=400
BASELOAD=95
BATT_MIN=10
BATT_MAX=95

# --- DEVICES & SECRETS ----

SMART_MANAGER_DYNAMIC_PARAMETER_PATH="/georg/cproj/Home-IT/smarthome/PV-PARAMETER.txt"

FRITZ_DEVICELIST="fritz"

FRITZ_DEVICEMAP="/georg/cproj/Home-IT/smarthome/device-map.json"

FRITZ_fritz_HOST="fritz.box"
FRITZ_fritz_USER="change-this"
FRITZ_fritz_PASSWORD="change-this"
