# --- DEVICES & SECRETS ----

# MQTT
SENSORS_MQTT_USERNAME="change-this"
SENSORS_MQTT_PASSWORD="change-this"

# Tasmota
TASMOTA_TAG="tasmota_828769"

# zendure Powerflow 800 Pro
ZENDURE_HOST="change-this"
ZENDURE_SN="change-this"
ZENDURE_MIN_BATTERY_LEVEL=10
ZENDURE_MIN_LIMIT_INTERVAL=10
ZENDURE_REPORT_PROPERTIES="solarPower1 solarPower2 solarPower3 solarPower4 electricLevel gridInputPower solarInputPower outputLimit gridOffPower BatVolt packInputPower outputPackPower packState remainOutTime hyperTmp outputHomePower acStatus"
ZENDURE_REPORT_PACK_PROPERTIES="socLevel state power"
ZENDURE_SEND_DATA_TO_MQTT_BROKER="yes"

#
# --- fixed config ---
#

# influx setup
INFLUX_ORG=smarthome
INFLUX_BUCKET=smarthome
INFLUX_RETENTION=366d
INFLUX_DERIVED_BUCKET=smarthomederived
INFLUX_DERIVED_RETENTION=1830d
INFLUX_LONGRANGE_BUCKET=longrange
INFLUX_LONGRANGE_RETENTION=0

# how to connect to influxdb internally
INFLUX_URL=http://influxdb:8086

# Compose/Grafana host UID for bind-mounted files.
USERID=1000
