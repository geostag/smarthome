MQTT_TOPIC="tele/+/SENSOR"
MQTT_USERNAME="change-this"
MQTT_PASSWORD="change-this"

# Tasmota
TASMOTA_TAG="tasmota_828769"

# mystrom switches
MYSTROM_SWITCHLIST="SOLAR"
MYSTROM_SOLAR_HOST="change-this"
MYSTROM_SOLAR_TOKEN="change-this"
MYSTROM_SOLAR_DEVICELABEL="solar"
MYSTROM_SOLAR_room="2 Joni my"
MYSTROM_SOLAR_electric="solar"


# zendure Powerflow 800 Pro
ZENDURE_HOST="change-this"
ZENDURE_SN="change-this"
ZENDURE_MIN_BATTERY_LEVEL=10
ZENDURE_REPORT_PROPERTIES="solarPower1 solarPower2 solarPower3 solarPower4 electricLevel gridInputPower solarInputPower outputLimit gridOffPower BatVolt packInputPower outputPackPower packState remainOutTime hyperTmp outputHomePower"
ZENDURE_REPORT_PACK_PROPERTIES="socLevel state power"
ZENDURE_SEND_DATA_TO_MQTT_BROKER="yes"

# SMARTTHINGS
SMARTTHINGS_QUERY_INTERVAL="120"
SMARTTHINGS_TOKEN="change-this"
SMARTTHINGS_DEVUCELIST="A"
SMARTTHINGS_A_ID="change-this"
