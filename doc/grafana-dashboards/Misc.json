      "pluginVersion": "12.3.1",
      "targets": [
        {
          "query": "data =\r\nfrom(bucket: \"smarthome\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"zendure\" and \r\n     (r._field == \"solarInputPower\" \r\n     or r._field == \"outputPackPower\" \r\n     or r._field == \"packInputPower\" \r\n     or r._field == \"gridInputPower\" \r\n     or r._field == \"outputHomePower\"))\r\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\r\n\r\npivoted =\r\ndata\r\n  |> pivot(\r\n      rowKey:[\"_time\"],\r\n      columnKey:[\"_field\"],\r\n      valueColumn:\"_value\"\r\n  )\r\n\r\ncalc =\r\npivoted\r\n  |> map(fn: (r) => {\r\n      solar = if exists r.solarInputPower then float(v: r.solarInputPower) else 0.0\r\n      packOut = if exists r.outputPackPower then float(v: r.outputPackPower) else 0.0\r\n      packIn = if exists r.packInputPower then float(v: r.packInputPower) else 0.0\r\n      home = if exists r.outputHomePower then float(v: r.outputHomePower) else 0.0\r\n\r\n      input = solar - packOut + packIn\r\n\r\n      return {\r\n          _time: r._time,\r\n          inverterInputPower: input,\r\n          inverterEfficiency:\r\n              if input > 0.0 then home / input else 0.0\r\n      }\r\n  })\r\n\r\n// Jetzt wieder in Zeitreihen-Format bringen\r\nc1 =\r\ncalc\r\n  |> map(fn: (r) => ({\r\n      _time: r._time,\r\n      _field: \"inverterInputPower\",\r\n      _value: r.inverterInputPower\r\n  }))\r\n\r\nc2 =\r\ncalc\r\n  |> map(fn: (r) => ({\r\n      _time: r._time,\r\n      _field: \"inverterEfficiency\",\r\n      _value: r.inverterEfficiency\r\n  }))\r\n\r\nsolar =\r\ndata |> filter(fn: (r) => r._field == \"solarInputPower\")\r\n|> keep(columns: [\"_time\", \"_field\", \"_value\"])\r\n\r\nunion(tables: [c1, c2, solar])\r\n  |> group(columns: [\"_field\"])\r\n",
          "refId": "A"
        }
      ],
