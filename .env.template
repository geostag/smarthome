# Compose/Grafana host UID for bind-mounted files.
USERID=1000

# Extra Python helpers to start in the scripts container.
# Example: SCRIPTS_EXTRA_FILES="smart-manager.py"
SCRIPTS_EXTRA_FILES=

# Top-level *2influxdb.py jobs that should run only once on container start.
SCRIPTS_ONE_SHOT_FILES="nextcloud-usage2influxdb.py schatzkiste-latest2influxdb.py"

# Interval to query REST APIs (seconds).
QUERY_INTERVAL=60
SMARTTHINGS_QUERY_INTERVAL=60
FRITZ_QUERY_INTERVAL=300
REMOTEWEATHER_INTERVAL=300

# --- Smart Manager ---
INJECTION_MAX=400
BASELOAD=95
BATT_MIN=10
BATT_MAX=95

# --- InfluxDB / Grafana ---
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=--replace-admin-token--
INFLUX_TOKEN_LONGRANGE=--replace-token-longrange--
INFLUX_ORG=smarthome
INFLUX_BUCKET=smarthome
INFLUX_DERIVED_BUCKET=smarthomederived
INFLUX_LONGRANGE_BUCKET=longrange
INFLUXDB_INIT_USERNAME=--replace-user--
INFLUXDB_INIT_PASSWORD=--replace-password--
INFLUXDB_INIT_RETENTION=1y

# --- Fritz!Box ---
FRITZ_DEVICELIST="fritz"
FRITZ_fritz_FEATURES="hosts transmission_rate ha"
FRITZ_DEVICEMAP=/app/config/fritz-devicemap.json
FRITZ_fritz_HOST=--replace-hostname--
FRITZ_fritz_USER=--replace-username--
FRITZ_fritz_PASSWORD=--replace-password--

# --- Schatzkiste ---
SCHATZKISTE_LOGDIR=/app/schatzkiste/stats

# --- Nextcloud ---
NEXTCLOUD_URL=--replace-hostname--
NEXTCLOUD_USER=--replace-username--
NEXTCLOUD_APITOKEN=--replace-token--

# --- MQTT / Tasmota ---
MQTT_BROKER=--replace-hostname--
MQTT_PORT=1883
MQTT_TOPIC=tele/+/SENSOR
MQTT_USERNAME=--replace-username--
MQTT_PASSWORD=--replace-password--
TASMOTA_TAG=tasmota_123456

# --- myStrom switches ---
MYSTROM_SWITCHLIST="SOLAR"
MYSTROM_SOLAR_HOST=--replace-hostname-with-trailing-slash--
MYSTROM_SOLAR_TOKEN=--replace-token--
MYSTROM_SOLAR_room="2 Joni my"
MYSTROM_SOLAR_electric=solar
MYSTROM_SOLAR_DEVICELABEL=solar

# --- Zendure Powerflow 800 Pro ---
ZENDURE_HOST=--replace-hostname--
ZENDURE_SN=--replace-serialnumber--
ZENDURE_MAX_INJECTION=800
ZENDURE_MIN_BATTERY_LEVEL=10
ZENDURE_REPORT_PROPERTIES="solarPower1 solarPower2 solarPower3 solarPower4 electricLevel gridInputPower solarInputPower outputLimit gridOffPower BatVolt packInputPower outputPackPower packState remainOutTime"
ZENDURE_REPORT_PACK_PROPERTIES="socLevel state power"
ZENDURE_SEND_DATA_TO_MQTT_BROKER=yes

# --- SmartThings ---
SMARTTHINGS_TOKEN=--replace-token--
SMARTTHINGS_DEVUCELIST="A B"
SMARTTHINGS_A_ID=--replace-id--
SMARTTHINGS_A_LABEL="1 Schlafzimmer"
SMARTTHINGS_B_ID=--replace-id--
SMARTTHINGS_B_LABEL="0 Wohnzimmer"

# --- Remote weather ---
REMOTEWEATHER_URL="https://api.openweathermap.org/data/2.5/weather?lat=48.09581237201164&lon=11.491786786342457&appid=--replace-api-key--"
